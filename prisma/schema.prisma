// Splittr data model. Money is integer paise. Everything lives in the "splittr"
// Postgres schema so nothing touches other apps' tables in public.
// Auth models (User, Session, Account, Verification) come from `npx auth generate`.

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["splittr"]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  upi           String?
  phone         String?
  theme         String?   @default("classic")
  tone          String?   @default("gentle")
  ageGroup          String? /// "adult" (18+) or "teen" (13-17); null until the person answers
  guardianEmail     String? /// a teen's parent or guardian, who must consent (DPDP Act s.9)
  guardianName      String?
  guardianConsentAt DateTime?
  aiConsentAt       DateTime? /// agreed to send photos/sentences to the AI reader; null = not asked or withdrawn
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  groupsCreated Group[]

  @@unique([email])
  @@map("user")
  @@schema("splittr")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("splittr")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("splittr")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("splittr")
}

model Group {
  id          String    @id
  name        String
  kind        String
  theme       String
  track       Boolean   @default(false)
  emoji       String? /// the group's face on home, in place of the kind icon
  cover       String? /// cover photo file name in the group's private files
  inviteCode  String    @unique
  createdById String? /// null once the creator deletes their account; the group lives on for everyone else
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members     Member[]
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("group")
  @@schema("splittr")
}

/// A person in a group. Guests have no userId until someone claims them via an invite.
model Member {
  id          String         @id
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  upi         String?
  email       String? /// invite target; auto-links when a user with this verified email exists or signs up
  phone       String? /// invite target via WhatsApp link (never auto-linked: phones aren't verified)
  inviteToken String?        @unique /// one-time claim link sent to this person
  invitedAt   DateTime?
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  shares      ExpenseShare[]
  createdAt   DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([email])
  @@map("member")
  @@schema("splittr")
}

model Expense {
  id          String         @id
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  cat         String
  date        String /// YYYY-MM-DD, the day it happened in the group's local time
  amount      Int /// paise
  mode        String?
  input       Json?
  settle      Boolean        @default(false)
  pending     Boolean        @default(false) /// settlement waiting for the payee to confirm; excluded from balances
  rejected    Boolean        @default(false) /// payee said it hasn't arrived; excluded from balances until the payer dismisses it
  receipt     String? /// photo file name in the private bucket, under the group's folder
  repeatNext  String?
  repeatDay   Int?
  createdById String?
  version     Int            @default(1) /// bumped on every change; writes must name the version they started from
  deletedAt   DateTime? /// soft delete: kept for history, restore and delta pulls; excluded from balances
  updatedById String?
  shares      ExpenseShare[]
  events      ExpenseEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([groupId])
  @@index([groupId, updatedAt])
  @@map("expense")
  @@schema("splittr")
}

/// Edit history: one row per change to an expense, written in the same transaction as the change.
model ExpenseEvent {
  id        String   @id @default(uuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  groupId   String
  version   Int /// the expense's version after this change
  action    String /// created | edited | deleted | restored | reverted
  revertOf  Int? /// for "reverted": the version restored
  byId      String? /// no relation: history outlives the account
  byName    String /// who, as they were named then
  at        DateTime @default(now())
  before    Json? /// the expense before (null when created)
  after     Json? /// the expense after (null when deleted)

  @@index([groupId, at])
  @@index([expenseId, version])
  @@map("expense_event")
  @@schema("splittr")
}

/// Who paid and who owes, per member, in paise. Per expense: sum(paid) == sum(owed) == amount.
model ExpenseShare {
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  paid      Int     @default(0)
  owed      Int     @default(0)

  @@id([expenseId, memberId])
  @@index([memberId])
  @@map("expense_share")
  @@schema("splittr")
}
