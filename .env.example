# Copy to .env and fill in. Never commit .env.

# Postgres (Supabase). Pooled URL (port 6543, pgbouncer) for the running API; direct URL (5432) for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Better Auth. Generate the secret with: openssl rand -base64 48
BETTER_AUTH_SECRET=""
# The web origin: the API is served same-origin under /api (Vite proxies in dev), so OAuth callbacks and cookies land on the app.
BETTER_AUTH_URL="http://localhost:5173"

# Deployed web app origin (trusted by auth + CORS), e.g. https://splittr.app
# PUBLIC_URL=""

# Build-time, client: API origin for the native apps (web uses same-origin /api). Must be https.
# VITE_API_URL="https://api.example.com"
# VITE_PUBLIC_URL="https://splittr.app"

# Email: ZeptoMail first, Resend as fallback; with neither set, emails print to the server console.
# EMAIL_FROM="Plico <no-reply@your-domain>"
# ZEPTOMAIL_TOKEN=""                              # Send Mail token (with or without the "Zoho-enczapikey " prefix)
# ZEPTOMAIL_URL="https://api.zeptomail.in/v1.1/email"   # .in for India-hosted accounts, .com otherwise
# RESEND_API_KEY=""

# Google sign-in (button stays hidden until the web client id + secret exist).
# GOOGLE_CLIENT_ID=""            # Web client (redirect flow + audience)
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_ANDROID_CLIENT_ID=""    # native ID-token sign-in
# GOOGLE_IOS_CLIENT_ID=""

# Phone verification over WhatsApp (Meta Cloud API). Leave any one empty and the feature is hidden and /webhooks/whatsapp is a 404.
# The business phone number ID (WhatsApp, API Setup), not the number itself
WA_PHONE_ID=
# A permanent System User access token with whatsapp_business_messaging
WA_TOKEN=
# App settings, Basic, App secret: checks the X-Hub-Signature-256 on every webhook call
WA_APP_SECRET=
# Any long random string; paste the same into the webhook settings in Meta’s dashboard
WA_VERIFY_TOKEN=
# Plico’s public WhatsApp number with country code, digits only, e.g. 919876543210
WA_NUMBER=
